"autocmd InsertLeave * set nopaste
autocmd InsertEnter * set paste
filetype plugin indent on
hi CursorColumn ctermbg=8
let g:python3_host_prog = '/bin/python3'
set ambw=double
set autoindent
set cursorcolumn
set encoding=utf-8
set fileencoding=utf-8
set hlsearch
set incsearch
set mouse=
set nocompatible
set noswapfile
set ruler
set t_u7=
set tabstop=4
set wildmenu
syntax on
"syntax sync minlines=200
