SHELL=/bin/sh
1 * * * * e H=/tmp/codex-cron; mkdir -p $H; ln -sf ~/.codex/auth.json $H/; CODEX_HOME=$H /bin/codex exec --sandbox read-only --skip-git-repo-check -c 'model="gpt-6-luna"' -c 'model_reasoning_effort="low"' -c 'web_search="disabled"' -c skills.bundled.enabled=false --disable apps --disable plugins --disable remote_plugin --disable shell_tool --disable shell_snapshot --disable view_image --disable image_generation --disable multi_agent hi </dev/null
2 1 * * * e MAX_THINKING_TOKENS=0 claude -p --model haiku --tools='' --strict-mcp-config 'hi'
2 11 * * * e MAX_THINKING_TOKENS=0 claude -p --model haiku --tools='' --strict-mcp-config 'hi'
2 16 * * * e MAX_THINKING_TOKENS=0 claude -p --model haiku --tools='' --strict-mcp-config 'hi'
2 20 * * * e MAX_THINKING_TOKENS=0 claude -p --model haiku --tools='' --strict-mcp-config 'hi'
2 21 * * * e MAX_THINKING_TOKENS=0 claude -p --model haiku --tools='' --strict-mcp-config 'hi'
2 6 * * * e MAX_THINKING_TOKENS=0 claude -p --model haiku --tools='' --strict-mcp-config 'hi'
17 *	* * *	root	cd / && run-parts --report /etc/cron.hourly
25 6	* * *	root	test -x /usr/sbin/anacron || { cd / && run-parts --report /etc/cron.daily; }
47 6	* * 7	root	test -x /usr/sbin/anacron || { cd / && run-parts --report /etc/cron.weekly; }
52 6	1 * *	root	test -x /usr/sbin/anacron || { cd / && run-parts --report /etc/cron.monthly; }
